# CC Admin — capability unlocks
#
# Install as:  /opt/radware/mgt-server/properties/cc_admin.properties
#              (root:root 0644, matching the 26 sibling property files)
#
# Presence of this file unlocks capabilities the running profile does not
# carry. It is NOT in the image and NOT created by any installer — it exists
# only where someone entitled to it put it there deliberately. The container
# mounts the properties directory READ-ONLY, so the app can never write its
# own unlock.
#
# A restart is required: routes are registered at startup, so the route table
# and the policy can never disagree, and an unlock is a visible event rather
# than a silent runtime flip.
#
#   docker compose -f /deploy/tools/kvision-infra-monitoring/docker-compose.yaml \
#       up -d --force-recreate cc-admin
#
# TO LOCK A CAPABILITY AGAIN, do any one of these — they are equivalent, since
# only 1 / true / yes / on / enabled (any case) counts as an unlock:
#
#   capability.es.artificial=false     flip the value
#   #capability.es.artificial=true     comment the line out
#                                      or delete the line entirely
#
# ...then restart the container, exactly as for an unlock. The startup log
# names what was unlocked, which is the quickest way to confirm it took:
#
#   [policy] unlocked by cc_admin.properties: es.artificial, ...
#
# THIS FILE ONLY ADDS, IT NEVER SUBTRACTS. A capability the running profile
# already grants cannot be switched off here — on an embedded CC,
# "capability.es.index.delete=false" leaves index deletion on, because the
# resolution is "granted by the profile OR unlocked by this file". That is
# deliberate: a support tool whose read paths could be stripped by a stray
# property line would be worse than one that cannot. To remove something the
# profile grants, the profile (or the capability declaration) has to change.
#
# IMPORTANT — "embedded" is a deployment shape, not a trust level. An embedded
# instance on an INTERNAL LAB CC is a perfectly good place to fabricate test
# data. An embedded instance on a CUSTOMER's production CC is not: synthetic
# documents are indistinguishable from real ones once written, which is the
# one outcome support must never cause. This file is how that judgement gets
# made per box instead of per build.

# Generate artificial documents into an index.
capability.es.artificial=true

# Copy an index to a new name, optionally shifting every date field.
capability.es.index.duplicate=true

# Delete a log, heap dump or zip from the System Health screen to reclaim disk.
#
# TWO KEYS, and this file is only the first. The host agent must ALSO be
# running with --allow-delete:
#
#   /opt/radware/cc_admin/host_agent.py --install --allow-delete
#
# Setting the line below without that changes nothing — the agent refuses, and
# says so. That is deliberate: the agent's rules live on the host, outside the
# container, so nothing shipped in an image can make an appliance delete files
# on its own.
#
# What can be removed is decided by modules/system/safety.py and again by the
# agent's own copy: logs, heap dumps and zips only, and never inside
# /opt/radware/storage/backup (the nightly MariaDB dumps repair_mysql_db.sh
# restores from), dc_config, or a datastore volume. On a real CC the eight
# largest files are typically Lucene segments, MariaDB's Aria log and an
# application jar — every one of them refused by name.
capability.system.storage.delete=true

# Not unlockable by design — an appliance follows the CC release train and
# cannot reach git from a customer network. Listed here only so nobody spends
# an afternoon wondering why it has no effect; it is ignored with a warning.
# capability.app.self_update=true
