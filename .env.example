# CC Elasticsearch Analyzer — Environment Variables
# Copy this file to .env and fill in your values

# Elasticsearch connection
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=http
ES_USER=
ES_PASSWORD=
ES_VERIFY_CERTS=false

# Service settings
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# Update checks — the UI shows a badge when the repository has a newer version.
# Nothing below is needed for the normal Docker deployment: deploy/update_agent.sh
# runs on the host and uses the git credentials that cloned the repo.
UPDATE_CHECK_ENABLED=true
# Set false for a check-only deployment (no one-click update button).
UPDATE_ALLOW_APPLY=true
# Only used when there is no host agent and no git checkout (see README):
#UPDATE_BB_TOKEN=
#UPDATE_BB_USER=
#UPDATE_BB_PASSWORD=

